{
  // API do ranking e do contador de online (spec 006-B).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onde-esta-flavio-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }]
  },
  // Plano gratuito só aceita Durable Object com SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Presence"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onde-esta-flavio",
      // preenchido pelo deploy (scripts/ensure-d1.mjs) — cria o banco se não existir
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Spec 010 (RF66): 60 requisições por minuto por IP (hash), antes de tocar
  // no D1 ou no contador.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true }
}
